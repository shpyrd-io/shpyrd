# The server image from binaries compiled outside Docker: the server and the
# PostgreSQL gateway, for linux/amd64 or linux/arm64. `make dev-image`
# compiles them for this machine; the release (`make ui release-binaries`)
# for both architectures, with Go's cache, which a build inside Docker
# starts without. The Dockerfile at the root builds the same image from
# source.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH
COPY bin/shpyrd-server-linux-${TARGETARCH} /shpyrd-server
# The PostgreSQL wake-on-connect proxy (RFC-0075) rides in the same image;
# the pg-gateway component runs it with args [/pg-gateway].
COPY bin/pg-gateway-linux-${TARGETARCH} /pg-gateway
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/shpyrd-server"]
